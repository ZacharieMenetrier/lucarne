{
  "name": "lucarne",
  "version": "0.1.0",
  "description": "A pixel art game engine where you draw, compose, code and play in one place.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./runtime/index.ts"
  },
  "bin": {
    "lucarne": "bin/lucarne.mjs"
  },
  "files": [
    "bin",
    "server",
    "editor",
    "runtime"
  ],
  "scripts": {
    "dev": "node bin/lucarne.mjs dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "rolldown": "~1.2.18",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
